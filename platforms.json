{
  "schema_version": 1,
  "platforms": [
    {
      "id": "codex",
      "kind": "cli",
      "aliases": ["openai-codex"],
      "executables": ["codex"],
      "version_probe": {"args": ["--version"]},
      "home_env": "CODEX_HOME",
      "default_home": "{home}/.codex",
      "skill_path": "{platform_home}/skills",
      "package": "codex-plugin",
      "mcp": {"mode": "codex-cli", "config": "{platform_home}/config.toml"},
      "hooks": {"mode": "native", "events": ["PreCompact", "PostCompact", "SessionStart", "SessionEnd"]},
      "agents": {"status": "not-exposed", "path": null},
      "sessions": {"status": "supported", "format": "codex-jsonl", "paths": ["{platform_home}/sessions"]}
    },
    {
      "id": "claude",
      "kind": "cli",
      "aliases": ["claude-code"],
      "executables": ["claude"],
      "version_probe": {"args": ["--version"]},
      "home_env": "CLAUDE_HOME",
      "default_home": "{home}/.claude",
      "skill_path": "{platform_home}/skills",
      "package": "claude-plugin",
      "mcp": {"mode": "claude-cli", "config": "{home}/.claude.json"},
      "hooks": {"mode": "native", "events": ["PreCompact", "PostCompact", "SessionStart", "SessionEnd"]},
      "agents": {"status": "supported", "path": "{platform_home}/agents"},
      "sessions": {"status": "supported", "format": "claude-jsonl", "paths": ["{platform_home}/projects"]}
    },
    {
      "id": "gemini",
      "kind": "cli",
      "aliases": ["gemini-cli"],
      "executables": ["gemini"],
      "version_probe": {"args": ["--version"]},
      "home_env": "GEMINI_HOME",
      "default_home": "{home}/.gemini",
      "skill_path": "{platform_home}/skills",
      "package": "gemini-extension",
      "mcp": {"mode": "json-mcpServers", "config": "{platform_home}/settings.json"},
      "hooks": {"mode": "native", "events": ["PreCompress", "SessionStart", "SessionEnd"]},
      "agents": {"status": "not-exposed", "path": null},
      "sessions": {"status": "not-exposed", "format": null, "paths": []}
    },
    {
      "id": "grok",
      "kind": "cli",
      "aliases": ["grok-build"],
      "executables": ["grok"],
      "version_probe": {"args": ["--version"]},
      "home_env": "GROK_HOME",
      "default_home": "{home}/.grok",
      "skill_path": "{platform_home}/skills",
      "package": "grok-plugin",
      "mcp": {"mode": "grok-cli", "config": "{platform_home}/config.toml"},
      "hooks": {"mode": "native", "events": ["PreCompact", "PostCompact", "SessionStart", "SessionEnd"]},
      "agents": {"status": "not-exposed", "path": null},
      "sessions": {"status": "not-exposed", "format": null, "paths": []}
    },
    {
      "id": "opencode",
      "kind": "cli",
      "aliases": ["opencode-v2"],
      "executables": ["opencode", "opencode2"],
      "version_probe": {"args": ["--version"]},
      "default_home": "{xdg_config}/opencode",
      "skill_path": "{platform_home}/skills",
      "package": "agent-skills",
      "mcp": {"mode": "json-opencode", "config": "{platform_home}/opencode.json"},
      "hooks": {"mode": "event-checkpoint", "events": ["session.compaction.started", "session.compaction.completed"]},
      "agents": {"status": "not-exposed", "path": null},
      "sessions": {"status": "not-exposed", "format": null, "paths": []}
    },
    {
      "id": "openclaw",
      "kind": "cli",
      "aliases": ["claw"],
      "executables": ["openclaw"],
      "version_probe": {"args": ["--version"]},
      "home_env": "OPENCLAW_HOME",
      "default_home": "{home}/.openclaw",
      "skill_path": "{platform_home}/skills",
      "package": "openclaw-plugin",
      "mcp": {"mode": "generated-snippet", "config": "{platform_home}/blue-sec-hub.mcp.json"},
      "hooks": {"mode": "native", "events": ["session_before_compact", "session_after_compact", "memoryFlush"]},
      "agents": {"status": "not-exposed", "path": null},
      "sessions": {"status": "not-exposed", "format": null, "paths": []}
    },
    {
      "id": "hermes",
      "kind": "cli",
      "aliases": ["hermes-agent"],
      "executables": ["hermes"],
      "version_probe": {"args": ["--version"]},
      "home_env": "HERMES_HOME",
      "default_home": "{home}/.hermes",
      "skill_path": "{platform_home}/skills",
      "package": "hermes-plugin",
      "mcp": {"mode": "hermes-cli", "config": "{platform_home}/config.yaml"},
      "hooks": {"mode": "native", "events": ["on_pre_compress", "on_session_start"]},
      "agents": {"status": "not-exposed", "path": null},
      "sessions": {"status": "supported", "format": "hermes-json", "paths": ["{platform_home}/sessions"]}
    },
    {
      "id": "trae",
      "kind": "ide",
      "aliases": ["trae-intl"],
      "executables": ["trae"],
      "version_probe": {"args": ["--version"]},
      "default_home": "{home}/.trae",
      "skill_path": "{platform_home}/skills",
      "package": "agent-skills",
      "detect_paths": ["{appdata}/Trae/User/mcp.json"],
      "mcp": {"mode": "json-mcpServers-if-present", "config": "{appdata}/Trae/User/mcp.json", "snippet": "{platform_home}/blue-sec-hub.mcp.json"},
      "hooks": {"mode": "event-checkpoint", "events": []},
      "agents": {"status": "not-exposed", "path": null},
      "sessions": {"status": "not-exposed", "format": null, "paths": []}
    },
    {
      "id": "trae-cn",
      "kind": "ide",
      "aliases": ["trae_cn", "trae(cn)"],
      "executables": ["trae-cn"],
      "version_probe": {"args": ["--version"]},
      "default_home": "{home}/.trae-cn",
      "skill_path": "{platform_home}/skills",
      "package": "agent-skills",
      "detect_paths": ["{appdata}/Trae CN/User/mcp.json"],
      "mcp": {"mode": "json-mcpServers-if-present", "config": "{appdata}/Trae CN/User/mcp.json", "snippet": "{platform_home}/blue-sec-hub.mcp.json"},
      "hooks": {"mode": "event-checkpoint", "events": []},
      "agents": {"status": "not-exposed", "path": null},
      "sessions": {"status": "not-exposed", "format": null, "paths": []}
    }
  ]
}
